default_platform(:android)

ROOT = File.expand_path("../..", __dir__)

platform :android do
  desc "Play Console 내부 테스트 트랙에 올린다. 먼저 flutter build appbundle로 번들을 만든다."
  lane :beta do
    upload_to_play_store(
      track: "internal",
      aab: "#{ROOT}/build/app/outputs/bundle/release/app-release.aab",
      json_key: File.expand_path(ENV.fetch("PLAY_JSON_KEY_PATH")),
      # 아직 한 번도 출시하지 않은 앱은 draft로만 올릴 수 있다: PLAY_RELEASE_STATUS=draft
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end
end
