# backend/README.md 5.1. 맥미니에서는 ~/srv/pillbbox-data/.env에 둔다.
PILLBBOX_DATABASE_URL=sqlite:///data/pillbbox.db
PILLBBOX_SAMPLES_DIR=data/samples
PILLBBOX_CORS_ORIGINS=http://localhost:8080
PILLBBOX_COMMIT=dev
# 식약처 공공데이터포털 일반 인증키(Decoding). 비우면 약 찾기·약 정보가 꺼진다 (README 3.5).
PILLBBOX_MFDS_SERVICE_KEY=
