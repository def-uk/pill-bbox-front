default_platform(:ios)

ROOT = File.expand_path("../..", __dir__)

platform :ios do
  desc "TestFlight에 올린다. 먼저 flutter build ipa로 아카이브를 만든다."
  lane :beta do
    key_path = File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
    )
    # 서명·내보내기는 API 키로 한다. Xcode에 Apple ID로 로그인하지 않아도
    # 배포 인증서와 프로비저닝 프로파일을 Xcode가 만든다(클라우드 서명).
    build_app(
      skip_build_archive: true,
      archive_path: "#{ROOT}/build/ios/archive/Runner.xcarchive",
      export_method: "app-store",
      output_directory: "#{ROOT}/build/ios/ipa",
      export_xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      ].join(" "),
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true,
    )
  end
end
